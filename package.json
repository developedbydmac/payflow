{
  "name": "payflow",
  "version": "1.0.0",
  "description": "PayFlow v2: a tiny payments app built to be tested, plus the Playwright framework and quality practices around it.",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developedbydmac/payflow.git"
  },
  "keywords": [],
  "author": "Daquan McDaniel",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/developedbydmac/payflow/issues"
  },
  "homepage": "https://github.com/developedbydmac/payflow#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
